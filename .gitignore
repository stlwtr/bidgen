# 虚拟环境
.venv/

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 生成产物（bidgen 输出的 Word）
/out/
/*.docx
/*.doc

# PyInstaller 打包产物
/build/
/dist/

# GUI 运行时供应商档案数据
/suppliers/

# 真实供应商配置（含隐私信息，勿提交；用 examples/supplier.example.yaml 作为模板复制）
/examples/supplier.yaml

# 招标文件 PDF（可能含敏感/非公开信息或受版权限制，勿提交；放到 docs/ 即可，已被忽略）
docs/*.pdf

# 编辑器 / 系统
.DS_Store
